#-------------------------------------------------------------
# INTERGRAPHICS - Sistema de Vacaciones
# Archivos que NO deben subirse a GitHub
#-------------------------------------------------------------

# Configuración local y contraseñas (correo SMTP, base de datos)
.env

# Archivos temporales que genera CodeIgniter (se conservan los index.html)
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/debugbar/*
!writable/debugbar/index.html

# Dependencias de Composer (si se instalan en el futuro)
vendor/

# Respaldos y archivos del sistema
*.bak
*.log
Thumbs.db
desktop.ini
.DS_Store

# Editores
.vscode/
.idea/
